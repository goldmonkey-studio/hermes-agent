# ============================================================================
#  Copie este arquivo para ".env" e preencha os valores.
#      cp .env.example .env
#  Depois gere senhas fortes. No Terminal do Mac, um jeito rápido:
#      openssl rand -base64 24
# ============================================================================

# ---- Banco de dados do Nextcloud ----
DB_ROOT_PASSWORD=troque-isto-senha-root-forte
DB_PASSWORD=troque-isto-senha-banco-forte

# ---- Conta administradora do Nextcloud (você vai usar para entrar) ----
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=troque-isto-senha-admin-forte

# ---- Tailscale: identifique seu Mac na rede privada ----
# Veja o nome e o IP no app Tailscale (ou rode: tailscale status).
# Exemplos: TAILSCALE_HOSTNAME=macbook-m2   TAILSCALE_IP=100.101.102.103
TAILSCALE_HOSTNAME=macbook-m2
TAILSCALE_IP=100.0.0.0

# ---- Vaultwarden: token do painel /admin ----
# Gere um valor bem longo e secreto (openssl rand -base64 48)
VW_ADMIN_TOKEN=troque-isto-token-admin-bem-longo
